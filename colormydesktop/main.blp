using Gtk 4.0;
using Gdk 4.0;
using Adw 1;

template $MyMainWindow : Adw.ApplicationWindow {
  title: "Color My Desktop";
  default-width: 1200;
  default-height: 800;
  decorated: false;

  Gtk.Box drag_frame {
    vexpand: true;
    hexpand: true;

    Gtk.Overlay root_overlay {
      child: Gtk.Box top_drag_bar {
        orientation: vertical;

        Adw.ToastOverlay toast_overlay {
          child: Adw.NavigationView nav_view {
            
            // DYNAMIC IMPORT: We drop your sub-page straight into the stack here!
            $PageHomeView home_view_panel {}
            
          };
        };
      };

      [overlay] 
      Gtk.Button close_btn { icon-name: "window-close-symbolic"; }
      
    }
  }
}
