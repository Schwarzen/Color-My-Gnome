using Gtk 4.0;

template $AdvancedPage : Gtk.Box {
  orientation: horizontal;
  spacing: 12;
  margin-top: 16;
  margin-bottom: 16;
  margin-start: 16;
  margin-end: 16;
  styles ["advanced-page"]

  Gtk.Frame {
    styles ["card"]

    Gtk.Box gnome_options {
      styles ["gnome-options"]
      orientation: vertical;
      margin-top: 12;
      margin-bottom: 12;
      margin-start: 12;
      margin-end: 12;
      spacing: 6;

      Gtk.Label {
        label: "GNOME options";
        styles ["heading"]
      }

      Gtk.Label {
        label: "This is the body text inside a Libadwaita-styled card component.";
        wrap: true;
      }
      Gtk.GestureClick {
        // Blueprint signals cannot parse input strings. Use discrete callback names.
        pressed => $on_gnome_card_pressed();
      }
    }
  }

  Gtk.Frame {
    styles ["card"]

    Gtk.Box {
      orientation: vertical;
      margin-top: 12;
      margin-bottom: 12;
      margin-start: 12;
      margin-end: 12;
      spacing: 6;

      Gtk.Label {
        label: "Card Title";
        styles ["heading"]
      }

      Gtk.Label {
        label: "This is the body text inside a Libadwaita-styled card component.";
        wrap: true;
      }

    }
  }

  Gtk.Frame {
    styles ["card"]

    Gtk.Box {
      orientation: vertical;
      margin-top: 12;
      margin-bottom: 12;
      margin-start: 12;
      margin-end: 12;
      spacing: 6;

      Gtk.Label {
        label: "Card Title";
        styles ["heading"]
      }

      Gtk.Label {
        label: "This is the body text inside a Libadwaita-styled card component.";
        wrap: true;
      }
    }
  }
}



