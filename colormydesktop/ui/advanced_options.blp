using Gtk 4.0;
using Adw 1;

template $AdvancedPage : Gtk.Box {
  // FIXED: Changed orientation to vertical to stack your cards cleanly
  orientation: vertical;
  spacing: 12;
  margin-top: 16;
  margin-bottom: 16;
  margin-start: 16;
  margin-end: 16;
  styles ["advanced-page"]

  // FIXED: Removed the "child:" keyword prefixes entirely.
  // Gtk.Box items stack sequentially straight inside braces.
  Gtk.Frame {
    styles ["card"]

    Gtk.Box {
      styles ["gnome-options"]
      orientation: vertical;
      margin-top: 12;
      margin-bottom: 12;
      margin-start: 12;
      margin-end: 12;
      spacing: 6;

      Gtk.Label {
        label: "Card Title";
        styles ["heading"]
      }

      Gtk.Label {
        label: "This is the body text inside a Libadwaita-styled card component.";
        wrap: true;
      }
    }
  }

  Gtk.Frame {
    styles ["card"]

    Gtk.Box {
      orientation: vertical;
      margin-top: 12;
      margin-bottom: 12;
      margin-start: 12;
      margin-end: 12;
      spacing: 6;

      Gtk.Label {
        label: "Card Title";
        styles ["heading"]
      }

      Gtk.Label {
        label: "This is the body text inside a Libadwaita-styled card component.";
        wrap: true;
      }
    }
  }

  Gtk.Frame {
    styles ["card"]

    Gtk.Box {
      orientation: vertical;
      margin-top: 12;
      margin-bottom: 12;
      margin-start: 12;
      margin-end: 12;
      spacing: 6;

      Gtk.Label {
        label: "Card Title";
        styles ["heading"]
      }

      Gtk.Label {
        label: "This is the body text inside a Libadwaita-styled card component.";
        wrap: true;
      }
    }
  }
}



